% snapdragon-theme.sty — visual identity for Snapdragon Games print materials.
%
% Brand palette mirrors frontend/src/app/home/home.component.scss:
%   bg / text  : near-black surface, warm-white type (used for callouts only;
%                printed pages stay light for cost-efficient printing).
%   accent     : #7c4dff       — primary purple for headings & links.
%   accent2    : #b388ff       — heading-gradient terminus.
%   accent-dim : #4a2fb5       — borderlines, light callout shading.
%   surface    : #12121e       — for dark code/quote blocks.
%   muted      : #7070a0       — secondary captions.
%
% Loaded by architecture.tex; safe to load multiple times.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{snapdragon-theme}[2026/04/26 Snapdragon Games print theme]

% ── Required packages ──────────────────────────────────────────────────────
\RequirePackage{xcolor}
\RequirePackage[T1]{fontenc}
\RequirePackage{csquotes}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tikz}
\RequirePackage{tcolorbox}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{enumitem}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{parskip}
\RequirePackage{graphicx}
\RequirePackage{listings}
\RequirePackage{caption}

\usetikzlibrary{positioning,arrows.meta,fit,shapes.geometric,backgrounds,calc}
\tcbuselibrary{breakable,skins,hooks,listings,xparse}

% ── Color tokens ──────────────────────────────────────────────────────────
\definecolor{snapAccent}{HTML}{7C4DFF}
\definecolor{snapAccentTwo}{HTML}{B388FF}
\definecolor{snapAccentDim}{HTML}{4A2FB5}
\definecolor{snapSurface}{HTML}{12121E}
\definecolor{snapBg}{HTML}{0A0A12}
\definecolor{snapText}{HTML}{1F1F2E}        % Dark on light page
\definecolor{snapMuted}{HTML}{6B6B85}
\definecolor{snapBorder}{HTML}{D8D6E5}
\definecolor{snapCodeBg}{HTML}{F4F2FA}
\definecolor{snapCodeBorder}{HTML}{E0DCEE}

% ── Page geometry / headers / titles ─────────────────────────────────────
% Only meaningful in a multi-page document; the standalone class used to
% render individual diagrams as PNGs has no chapter machinery and would
% blow up on \renewcommand{\chaptermark}. Gate everything in this block
% on the host being a book/report-style class.
\@ifundefined{chapter}{}{%
  \geometry{
    paperwidth=210mm,paperheight=297mm,
    inner=22mm,outer=22mm,top=24mm,bottom=24mm,
    headsep=10mm,footskip=14mm,
  }
  \pagestyle{fancy}
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
  \fancyhead[LE,RO]{\small\color{snapMuted}\thepage}
  \fancyhead[RE,LO]{\small\color{snapMuted}\nouppercase{\leftmark}}
  \fancyfoot[C]{\small\color{snapMuted}Snapdragon Games --- Architecture Reference}

  \renewcommand{\chaptermark}[1]{\markboth{#1}{}}
  \renewcommand{\sectionmark}[1]{\markright{#1}{}}

  \titleformat{\chapter}[display]
    {\sffamily\bfseries\color{snapAccent}\fontsize{38}{42}\selectfont}
    {\color{snapAccentDim}\normalsize\textsf{CHAPTER \thechapter}}
    {12pt}
    {\color{snapText}}
    [\vspace{4pt}\textcolor{snapAccent}{\rule{0.35\linewidth}{1.5pt}}]
  \titlespacing*{\chapter}{0pt}{-8pt}{36pt}

  \titleformat{\section}
    {\sffamily\bfseries\color{snapAccent}\Large}
    {\thesection}{1em}{}
  \titleformat{\subsection}
    {\sffamily\bfseries\color{snapText}\large}
    {\thesubsection}{1em}{}
}

% ── Hyperlink color ───────────────────────────────────────────────────────
% (hyperref is loaded in the main file with the right options; we just set
% colors here so the package is loaded once at the right time.)
% \hypersetup only matters when hyperref is loaded — the architecture
% PDF loads it; the standalone wrapper used to render individual
% diagrams to PNG does not. Gate so the theme can ship into both.
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \hypersetup{%
      colorlinks=true,
      linkcolor=snapAccent,
      citecolor=snapAccent,
      urlcolor=snapAccent,
      pdfborder={0 0 0},
    }%
  }{}%
}

% ── Code listings ─────────────────────────────────────────────────────────
\lstdefinestyle{snapdragon}{
  basicstyle=\ttfamily\small\color{snapText},
  keywordstyle=\color{snapAccent}\bfseries,
  commentstyle=\color{snapMuted}\itshape,
  stringstyle=\color{snapAccentDim},
  backgroundcolor=\color{snapCodeBg},
  frame=single,
  framerule=0pt,
  rulecolor=\color{snapCodeBorder},
  framexleftmargin=8pt,
  framexrightmargin=8pt,
  framextopmargin=4pt,
  framexbottommargin=4pt,
  xleftmargin=8pt,
  xrightmargin=8pt,
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=true,
  columns=fullflexible,
  tabsize=2,
  aboveskip=10pt,
  belowskip=10pt,
}
\lstset{style=snapdragon}

% listings doesn't ship json/javascript/html languages; define permissive
% variants so the LaTeX source doesn't have to care which dialect is used.
\lstdefinelanguage{json}{
  sensitive=true,
  morestring=[b]",
  morecomment=[l]{//},
}
\lstdefinelanguage{javascript}{
  sensitive=true,
  keywords={async,await,break,case,catch,class,const,continue,debugger,
            default,delete,do,else,export,extends,false,finally,for,function,
            from,if,import,in,instanceof,let,new,null,of,return,super,switch,
            this,throw,true,try,typeof,var,void,while,with,yield},
  keywordstyle=\color{snapAccent}\bfseries,
  morestring=[b]",morestring=[b]',morestring=[b]`,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
}
\lstdefinelanguage{html}{
  sensitive=false,
  morestring=[b]",
  morecomment=[s]{<!--}{-->},
  morekeywords={app-three-wizards-remote,app-dodecahedron-remote,
                app-game-canvas,switch,case,doctype,html,head,body,div,span,a,
                href,id,class,iframe,src,title,style,script,template},
  keywordstyle=\color{snapAccent}\bfseries,
}

% ── Callout boxes ─────────────────────────────────────────────────────────
\newtcolorbox{snapnote}[1][]{
  enhanced,breakable,
  colback=snapCodeBg,colframe=snapAccent,
  colbacktitle=snapAccent,coltitle=white,
  fonttitle=\sffamily\bfseries,
  arc=2pt,boxrule=0.6pt,
  left=10pt,right=10pt,top=8pt,bottom=8pt,
  toptitle=4pt,bottomtitle=4pt,
  title={Note},#1
}
\newtcolorbox{snapcaution}[1][]{
  enhanced,breakable,
  colback=snapCodeBg!90!yellow,colframe=orange!80!red,
  colbacktitle=orange!80!red,coltitle=white,
  fonttitle=\sffamily\bfseries,
  arc=2pt,boxrule=0.6pt,
  left=10pt,right=10pt,top=8pt,bottom=8pt,
  toptitle=4pt,bottomtitle=4pt,
  title={Caution},#1
}
\newtcolorbox{snapdark}[1][]{
  enhanced,breakable,
  colback=snapBg,colframe=snapAccent,
  coltext=white,
  fonttitle=\sffamily\bfseries\color{white},
  arc=2pt,boxrule=0pt,
  left=12pt,right=12pt,top=10pt,bottom=10pt,
  #1,
}

% ── List spacing ──────────────────────────────────────────────────────────
\setlist[itemize]{leftmargin=18pt,topsep=4pt,itemsep=2pt,parsep=0pt}
\setlist[enumerate]{leftmargin=24pt,topsep=4pt,itemsep=2pt,parsep=0pt}

% ── Caption styling ───────────────────────────────────────────────────────
\captionsetup{font=small,labelfont={color=snapAccent,bf,sf},textfont={color=snapText}}

% ── TikZ shared styles ────────────────────────────────────────────────────
\tikzset{
  snapnode/.style={
    draw=snapAccent,thick,fill=white,
    rounded corners=4pt,
    inner sep=8pt,minimum height=12mm,
    font=\sffamily\small,text=snapText,
    align=center,
  },
  snapdarknode/.style={
    snapnode,fill=snapBg,text=white,
    draw=snapAccentTwo,
  },
  snapaccent/.style={
    snapnode,fill=snapAccent,text=white,
    draw=snapAccentDim,
  },
  snapedge/.style={
    -{Stealth[length=2.5mm]},
    snapAccentDim,thick,
  },
  snaplabel/.style={
    font=\sffamily\footnotesize\color{snapMuted},
    fill=white,inner sep=2pt,
  },
}

% ── Helpers ───────────────────────────────────────────────────────────────
%
% Inline file paths and command names CAN'T break in plain \texttt{}, so a
% long path like docs/PLAN-module-federation-and-native.md ends up jutting
% into the right margin when typeset inside body text. Use the url package's
% \DeclareUrlCommand which produces typewriter output with allowable break
% points after '/', '_', '-', '.', and '~'. The argument is treated mostly
% verbatim — that means the call sites must use RAW underscores, not the
% LaTeX-escaped '\_' that plain \texttt{} requires.
\RequirePackage{url}

\DeclareUrlCommand{\snap@brkpath}{\color{snapAccentDim}\ttfamily}

% These are \DeclareRobustCommand because they appear inside captions and
% other "moving arguments" (.aux/.toc writes), and url-package commands
% expand wrong in those contexts. The robust wrapper makes the macro
% survive intact until typesetting.
\DeclareRobustCommand{\snapcommand}[1]{\snap@brkpath{#1}}
\DeclareRobustCommand{\snapfile}[1]{\snap@brkpath{#1}}

\newcommand{\repolink}[2]{\href{https://github.com/Snapdragon-Systems/ThreeWizardsInATrenchcoat/blob/main/#1}{#2}}

% \reposrc has to keep the file-path text break-friendly the same way
% \snapfile does, but it ALSO has to live inside \href{...}{<text>} where
% the second arg is normal LaTeX. \snap@brkpath uses url's break logic,
% which composes inside \href.
\DeclareRobustCommand{\reposrc}[1]{\href{https://github.com/Snapdragon-Systems/ThreeWizardsInATrenchcoat/blob/main/#1}{\snap@brkpath{#1}}}

% Give LaTeX three more ems of slack on each line so paragraphs with
% otherwise-unbreakable tokens (URLs, capitalised model names, the rare
% texttt segment without separators) still settle without sticking into
% the margin. \sloppy is enabled per-document in architecture.tex so
% individual chapters can opt out via {\fussy ...} if they need a tighter
% setting for a specific block.
\setlength{\emergencystretch}{3em}

% Marble-diagram styles. Used to visualise a Project Reactor / RxJava-
% style chain on a controller method: the upstream Mono/Flux is a time
% line, concrete value "marbles" carry the Java type as a label, an
% operator box transforms the line, and the downstream is another line.
% Each *kind* of value uses a DISTINCT marble shape so a reader can
% scan the diagram and infer reactor topology at a glance:
%
%   circle    — Mono<T> / single value
%   square    — Flux<T> element (one of N events)
%   pentagon  — ServerSentEvent (web-tier emission)
%   hexagon   — R2DBC transactional unit / DB-touching value
%   triangle  — control / signal (e.g. movement event, keepalive)
%   star      — onError / failure marble
%   bar       — onComplete sentinel (a thin filled rectangle)
%
% The colour stays in the brand purple family; only shape varies.
% A \snapmarblelegend below each diagram explains what each shape +
% type means in the *specific* controller's chain (the legend lists
% the relevant fields/flags of the carried object).
\usetikzlibrary{shapes.geometric,shapes.symbols}

\tikzset{
  marbleline/.style={
    -{Stealth[length=2.2mm]},
    snapAccentDim,line width=0.6pt,
  },
  % Common base — every marble shares colour, line, font, label sizing.
  marble@base/.style={
    draw=snapAccentDim,fill=snapAccent!18,
    line width=0.5pt,inner sep=0pt,
    minimum size=5.8mm,
    font=\sffamily\bfseries\scriptsize,text=snapText,
  },
  % Per-shape variants
  marbleMono/.style    ={marble@base,circle},
  marbleFlux/.style    ={marble@base,rectangle},
  marbleSSE/.style     ={marble@base,regular polygon,regular polygon sides=5},
  marbleTx/.style      ={marble@base,regular polygon,regular polygon sides=6,
                          minimum size=6.4mm},
  marbleSig/.style     ={marble@base,isosceles triangle,
                          isosceles triangle apex angle=60,
                          shape border rotate=90,minimum size=4.8mm},
  marbleErr/.style     ={marble@base,star,star points=5,
                          fill=red!18,draw=red!70!black,minimum size=6mm},
  marbleDone/.style    ={marble@base,rectangle,minimum width=1.6mm,
                          minimum height=5.6mm,fill=snapAccentDim},
  % Operator box: a labelled rounded rectangle between two lines.
  marbleop/.style={
    draw=snapAccent,fill=snapAccent!8,line width=0.6pt,
    rounded corners=2pt,
    minimum height=8mm,minimum width=24mm,inner sep=4pt,
    font=\sffamily\small,text=snapAccentDim,align=center,
  },
  % Optional caption above a marble — the concrete instance type, e.g.
  % "Mono<UploadRequest>" or just the field that varies (slug=test-fixture).
  marbletype/.style={
    font=\sffamily\scriptsize\itshape,text=snapAccentDim,
    inner sep=1pt,
  },
  marbleaxis/.style={
    font=\sffamily\scriptsize\bfseries,text=snapMuted,
    anchor=east,inner sep=2pt,
  },
}

% \snapmarbleline{coord-prefix}{y}{axis label}{x-start}{x-end}
% Draws one horizontal time line with an axis caption on its left.
\newcommand{\snapmarbleline}[5]{%
  \node[marbleaxis] at (#4-6mm,#2) {#3};%
  \draw[marbleline] (#4,#2) -- (#5,#2);%
  \coordinate (#1-start) at (#4,#2);%
  \coordinate (#1-end)   at (#5,#2);%
}

% \snapmarblelegend{ rows }
%
% Renders a legend table directly below a marble diagram. Each row
% pairs a shape (rendered as a tiny inline tikzpicture) with the
% object name and the fields/flags carried by that marble. Use as:
%
%   \snapmarblelegend{
%     marbleMono & UploadRequest & file: MultipartFile · casdoorUserId · contentLength \\
%     marbleTx   & InstalledBundle & slug · contentHash · versionDir · uploadedAt · supersededAt \\
%     marbleErr  & UploadException & status (4xx/5xx) · cause · slug \\
%   }
\newcommand{\snapmarbleshape}[1]{%
  \tikz[baseline=-0.6ex]{\node[#1,minimum size=3.6mm,font=\tiny] {};}%
}
\newcommand{\snapmarblelegend}[1]{%
  \par\smallskip
  \begingroup\small
  \setlength{\tabcolsep}{4pt}%
  % tabularx with X column lets the "Relevant fields / flags" cell wrap
  % to whatever width remains after the fixed shape + object columns,
  % which keeps the legend inside textwidth even with verbose field
  % lists. \arraybackslash so \\ still works as a row separator inside X.
  \begin{tabularx}{\linewidth}{@{}c l >{\raggedright\arraybackslash}X@{}}
    \toprule
    \textbf{Shape} & \textbf{Object} & \textbf{Relevant fields / flags} \\
    \midrule
    #1
    \bottomrule
  \end{tabularx}
  \endgroup
  \par\smallskip
}

% \snapdiagram{path/to/figure.tex}
%
% Wrap a TikZ figure include so it always fits the text width without
% manual tuning per diagram. The natural diagram size is whatever the
% TikZ source produces; \resizebox scales uniformly, capping at
% 0.95\textwidth so the figure breathes in the margin and capping the
% height at 0.7\textheight so a tall diagram doesn't push its caption
% off the page. Diagrams that are already narrow are *not* enlarged
% (the second branch of the conditional renders the natural size).
\newlength{\snap@diagwd}
\newcommand{\snapdiagram}[1]{%
  \par\vspace{2pt}%
  \begingroup
    \sbox0{\input{#1}}%
    \setlength{\snap@diagwd}{\wd0}%
    \ifdim\snap@diagwd>0.95\textwidth
      \resizebox{0.95\textwidth}{!}{\usebox0}%
    \else
      \usebox0
    \fi
  \endgroup
  \par
}

\endinput
