{
  "openapi": "3.0.3",
  "info": {
    "title": "Snapdragon Gaming BFF",
    "version": "0.1.0-fallback",
    "description": "Static fallback spec used by the publishing pipeline when the live BFF isn't reachable. The schema bodies and parameter shapes here are deliberately thin — bring the BFF up and re-run `make docs-openapi-spec` to refresh against the canonical /v3/api-docs."
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Local compose stack" }
  ],
  "tags": [
    { "name": "Authentication" },
    { "name": "Game stream" },
    { "name": "Games" },
    { "name": "Levels" },
    { "name": "Level assets" },
    { "name": "Assets" },
    { "name": "Controls" },
    { "name": "Federation" },
    { "name": "Game launches" },
    { "name": "Game uploads" },
    { "name": "Game access" },
    { "name": "Roles" },
    { "name": "Input events" },
    { "name": "Diagnostics" },
    { "name": "Multiplayer sessions",
      "description": "Named multiplayer sessions — create, list, join, leave, close. Hot-path control fan-out via per-session SSE sinks." },
    { "name": "View egress",
      "description": "Per-player camera/orientation samples streamed by the Rust GDExtension." },
    { "name": "Admin session stream",
      "description": "Per-session SSE merge for admin observation." },
    { "name": "Admin debug mode",
      "description": "Admin-only runtime toggles for diagnostics ingest." },
    { "name": "Moderation",
      "description": "Per-game moderator actions: stop a session, kick a player." },
    { "name": "Publisher",
      "description": "Per-game publisher actions: list owned games, grant/revoke mod role." },
    { "name": "Admin role grants",
      "description": "Admin-only management of per-game mod and publisher scopes." }
  ],
  "paths": {
    "/api/auth/token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Exchange Casdoor authorization code for an access token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TokenExchangeRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK", "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" }}
          }}
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Return resolved Casdoor user from the bearer token.",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/game/stream": {
      "get": {
        "tags": ["Game stream"],
        "summary": "Server-Sent Events merged stream (5 typed channels + keepalive).",
        "responses": {
          "200": {
            "description": "text/event-stream",
            "content": { "text/event-stream": {} }
          }
        }
      }
    },
    "/api/games": {
      "get": {
        "tags": ["Games"],
        "summary": "List visible games (filtered by game_access).",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/games/{slug}": {
      "get": {
        "tags": ["Games"],
        "summary": "One game by slug.",
        "parameters": [
          { "name": "slug", "in": "path", "required": true,
            "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/levels/{id}": {
      "get": {
        "tags": ["Levels"],
        "summary": "Level row including asset_url.",
        "parameters": [
          { "name": "id", "in": "path", "required": true,
            "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/levels/{id}/scene": {
      "get": {
        "tags": ["Levels"],
        "summary": "Typed SceneDto for the in-game scene_loader.",
        "parameters": [
          { "name": "id", "in": "path", "required": true,
            "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/levels/{levelId}/assets": {
      "get": {
        "tags": ["Level assets"],
        "summary": "List per-level registered assets.",
        "parameters": [
          { "name": "levelId", "in": "path", "required": true,
            "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Level assets"],
        "summary": "Register a per-level asset (texture / audio / plugin).",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/controls/{characterId}": {
      "post": {
        "tags": ["Controls"],
        "summary": "Submit a session-validated control event.",
        "parameters": [
          { "name": "characterId", "in": "path", "required": true,
            "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": { "required": true, "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ControlEvent" }}
        }},
        "responses": { "204": { "description": "No Content" }, "403": { "description": "Forbidden" } }
      }
    },
    "/api/federation/manifest": {
      "get": {
        "tags": ["Federation"],
        "summary": "DB-backed federation manifest (host import map).",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/games/{slug}/launch": {
      "post": {
        "tags": ["Game launches"],
        "summary": "Mint a launch_uid for the calling session.",
        "parameters": [
          { "name": "slug", "in": "path", "required": true,
            "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/games/launches/{uid}": {
      "delete": {
        "tags": ["Game launches"],
        "summary": "Self-terminate a launch (owner only).",
        "parameters": [
          { "name": "uid", "in": "path", "required": true,
            "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "No Content" } }
      }
    },
    "/api/admin/launches/{uid}": {
      "delete": {
        "tags": ["Game launches"],
        "summary": "Force-revoke any launch (admin only).",
        "parameters": [
          { "name": "uid", "in": "path", "required": true,
            "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "No Content" } }
      }
    },
    "/api/admin/games/upload": {
      "post": {
        "tags": ["Game uploads"],
        "summary": "Hot-upload a game bundle zip.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary",
                            "description": "Snapdragon Export bundle (.zip)" }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/admin/games/{slug}/uploads": {
      "get": {
        "tags": ["Game uploads"],
        "summary": "Rollback history for a slug (newest first).",
        "parameters": [
          { "name": "slug", "in": "path", "required": true,
            "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/admin/games/{slug}/access": {
      "get": {
        "tags": ["Game access"],
        "summary": "List game_access policy rows for a slug.",
        "parameters": [
          { "name": "slug", "in": "path", "required": true,
            "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Game access"],
        "summary": "Add a game_access row (scope=all|role|user).",
        "parameters": [
          { "name": "slug", "in": "path", "required": true,
            "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/AccessGrantRequest" }}
        }},
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Game access"],
        "summary": "Remove a game_access row.",
        "parameters": [
          { "name": "slug", "in": "path", "required": true,
            "schema": { "type": "string" } },
          { "name": "scope", "in": "query", "required": true,
            "schema": { "type": "string" } },
          { "name": "value", "in": "query", "required": false,
            "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "No Content" } }
      }
    },
    "/api/admin/roles": {
      "get": {
        "tags": ["Roles"],
        "summary": "Proxy Casdoor's role catalog (live).",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": ["Multiplayer sessions"],
        "summary": "List open multiplayer sessions, optionally filtered by gameSlug.",
        "parameters": [
          { "name": "gameSlug", "in": "query", "required": false,
            "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Multiplayer sessions"],
        "summary": "Create a new named multiplayer session; caller becomes the creator member.",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/sessions/{id}": {
      "get": {
        "tags": ["Multiplayer sessions"],
        "summary": "Get one session with active members.",
        "parameters": [{ "name": "id", "in": "path", "required": true,
                          "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Multiplayer sessions"],
        "summary": "Force-close a session (creator only).",
        "parameters": [{ "name": "id", "in": "path", "required": true,
                          "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "204": { "description": "No Content" } }
      }
    },
    "/api/sessions/{id}/join": {
      "post": {
        "tags": ["Multiplayer sessions"],
        "summary": "Join a session at an optional slot. Idempotent on (sessionId, casdoorId).",
        "parameters": [{ "name": "id", "in": "path", "required": true,
                          "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "OK" },
          "409": { "description": "Slot already claimed or session full" },
          "410": { "description": "Session already closed" }
        }
      }
    },
    "/api/sessions/{id}/me": {
      "delete": {
        "tags": ["Multiplayer sessions"],
        "summary": "Leave a session (auto-closes when last active member leaves).",
        "parameters": [{ "name": "id", "in": "path", "required": true,
                          "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "204": { "description": "No Content" } }
      }
    },
    "/api/view": {
      "post": {
        "tags": ["View egress"],
        "summary": "Submit a player-view sample (per-slot camera + orientation).",
        "responses": {
          "202": { "description": "Accepted" },
          "403": { "description": "Caller is not the active session_member who owns characterId" }
        }
      }
    },
    "/api/admin/sessions/{id}/stream": {
      "get": {
        "tags": ["Admin session stream"],
        "summary": "Per-session SSE merge — movement / world / character / view, scoped to one session id (ROLE_ADMIN).",
        "parameters": [{ "name": "id", "in": "path", "required": true,
                          "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "text/event-stream" } }
      }
    },
    "/api/admin/debug-mode": {
      "get": {
        "tags": ["Admin debug mode"],
        "summary": "Read current debug-mode flags (ROLE_ADMIN).",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/admin/debug-mode/wasm-console": {
      "put": {
        "tags": ["Admin debug mode"],
        "summary": "Toggle WASM console capture (ROLE_ADMIN).",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/mod/scopes": {
      "get": {
        "tags": ["Moderation"],
        "summary": "List the games this caller may moderate (ROLE_MOD or ROLE_ADMIN).",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/mod/sessions/{id}/stop": {
      "post": {
        "tags": ["Moderation"],
        "summary": "Force-close a session (ROLE_MOD scoped to the session's game, or ROLE_ADMIN).",
        "parameters": [{ "name": "id", "in": "path", "required": true,
                          "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "OK" },
          "403": { "description": "Caller is not scoped to the target session's game" }
        }
      }
    },
    "/api/mod/sessions/{id}/kick": {
      "post": {
        "tags": ["Moderation"],
        "summary": "Kick a single player from a session.",
        "parameters": [{ "name": "id", "in": "path", "required": true,
                          "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "OK" },
          "403": { "description": "Caller is not scoped to the target session's game" },
          "404": { "description": "Target is not an active member" }
        }
      }
    },
    "/api/publisher/scopes": {
      "get": {
        "tags": ["Publisher"],
        "summary": "List the games the caller publishes (ROLE_PUBLISHER or ROLE_ADMIN).",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/publisher/games/{gameSlug}/mods": {
      "get": {
        "tags": ["Publisher"],
        "summary": "List active mods for one of the caller's games.",
        "parameters": [{ "name": "gameSlug", "in": "path", "required": true,
                          "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/publisher/grant-mod": {
      "post": {
        "tags": ["Publisher"],
        "summary": "Grant the mod role for a game the caller owns. Idempotent.",
        "responses": {
          "200": { "description": "OK" },
          "403": { "description": "Caller does not own the target game" }
        }
      }
    },
    "/api/publisher/revoke-mod": {
      "post": {
        "tags": ["Publisher"],
        "summary": "Revoke a previously-granted mod scope (soft-delete).",
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "No active mod scope to revoke" }
        }
      }
    },
    "/api/admin/role-grants/publishers": {
      "get": { "tags": ["Admin role grants"],
               "summary": "List every active publisher scope (ROLE_ADMIN).",
               "responses": { "200": { "description": "OK" } } }
    },
    "/api/admin/role-grants/mods": {
      "get": { "tags": ["Admin role grants"],
               "summary": "List every active mod scope (ROLE_ADMIN).",
               "responses": { "200": { "description": "OK" } } }
    },
    "/api/admin/role-grants/grant-publisher": {
      "post": { "tags": ["Admin role grants"],
                "summary": "Grant publisher scope for a game (ROLE_ADMIN).",
                "responses": { "200": { "description": "OK" } } }
    },
    "/api/admin/role-grants/revoke-publisher": {
      "post": { "tags": ["Admin role grants"],
                "summary": "Revoke publisher scope (soft-delete).",
                "responses": { "200": { "description": "OK" } } }
    },
    "/api/admin/role-grants/grant-mod": {
      "post": { "tags": ["Admin role grants"],
                "summary": "Grant mod scope for a game (ROLE_ADMIN).",
                "responses": { "200": { "description": "OK" } } }
    },
    "/api/admin/role-grants/revoke-mod": {
      "post": { "tags": ["Admin role grants"],
                "summary": "Revoke mod scope (soft-delete).",
                "responses": { "200": { "description": "OK" } } }
    },
    "/api/input/{characterId}": {
      "post": {
        "tags": ["Input events"],
        "summary": "Submit a generalised input event (gamepad/mouse/keyboard/touch/audio/world/control).",
        "parameters": [
          { "name": "characterId", "in": "path", "required": true,
            "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": { "required": true, "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/InputEvent" }}
        }},
        "responses": { "202": { "description": "Accepted" }, "400": { "description": "Unknown (kind, type)" }, "405": { "description": "Game refuses this kind" } }
      }
    },
    "/api/input/character/{characterId}": {
      "get": {
        "tags": ["Input events"],
        "summary": "Recent events for a character (newest first).",
        "parameters": [
          { "name": "characterId", "in": "path", "required": true,
            "schema": { "type": "integer", "format": "int64" } },
          { "name": "limit", "in": "query", "required": false,
            "schema": { "type": "integer", "default": 100, "maximum": 1000 } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/input/session/{sessionId}": {
      "get": {
        "tags": ["Input events"],
        "summary": "Recent events for a session (newest first).",
        "parameters": [
          { "name": "sessionId", "in": "path", "required": true,
            "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false,
            "schema": { "type": "integer", "default": 100, "maximum": 1000 } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/diagnostics/wasm-console": {
      "post": {
        "tags": ["Diagnostics"],
        "summary": "Forward one WASM iframe console line to the SSE wasm-console channel.",
        "requestBody": { "required": true, "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/WasmConsoleLine" }}
        }},
        "responses": { "202": { "description": "Accepted" } }
      }
    }
  },
  "components": {
    "schemas": {
      "TokenExchangeRequest": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "redirectUri": { "type": "string" },
          "state": { "type": "string" }
        },
        "required": ["code", "redirectUri"]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "refreshToken": { "type": "string" },
          "casdoorUserId": { "type": "string" }
        }
      },
      "ControlEvent": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" },
          "action": { "type": "string", "enum": ["move", "cast", "interact"] },
          "x": { "type": "number" }, "y": { "type": "number" },
          "pressed": { "type": "boolean" },
          "spellSlot": { "type": "integer", "nullable": true }
        }
      },
      "AccessGrantRequest": {
        "type": "object",
        "properties": {
          "scope": { "type": "string", "enum": ["all", "role", "user"] },
          "value": { "type": "string", "nullable": true }
        },
        "required": ["scope"]
      },
      "InputEvent": {
        "type": "object",
        "properties": {
          "gameSlug":     { "type": "string" },
          "characterId":  { "type": "integer", "format": "int64", "nullable": true },
          "sessionId":    { "type": "string" },
          "kind":         { "type": "string", "enum": ["gamepad","mouse","keyboard","touch","audio","world","control"] },
          "type":         { "type": "string", "description": "Per-kind type — see input_event_types reference table." },
          "payload":      { "type": "object", "additionalProperties": true }
        },
        "required": ["gameSlug","sessionId","kind","type","payload"]
      },
      "WasmConsoleLine": {
        "type": "object",
        "properties": {
          "level":     { "type": "string", "enum": ["error","warn","info","log"] },
          "gameSlug":  { "type": "string", "nullable": true },
          "levelSlug": { "type": "string", "nullable": true },
          "message":   { "type": "string" },
          "source":    { "type": "string", "nullable": true },
          "line":      { "type": "integer", "nullable": true },
          "column":    { "type": "integer", "nullable": true },
          "stack":     { "type": "string", "nullable": true }
        },
        "required": ["level","message"]
      }
    }
  }
}
