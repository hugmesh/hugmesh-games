# Godot 4+
.godot/
.nomedia
.import/
export.cfg
export_credentials.cfg
*.translation
.mono/
data_*/
mono_crash.*.json

# Rust GDExtension (hugmesh-bridge)
extensions/hugmesh-bridge/target/
# Binaries are produced by `make build-rust` and copied into each game
# project's bin/ — never committed (only the per-bin .gitkeep is).
extensions/hugmesh-bridge/bin/*.so
extensions/hugmesh-bridge/bin/*.dll
extensions/hugmesh-bridge/bin/*.dylib
extensions/hugmesh-bridge/bin/*.wasm
games/*/bin/*.so
games/*/bin/*.dll
games/*/bin/*.dylib
games/*/bin/*.wasm

# Godot web export output (generated by build)
frontend/src/assets/game/*.html
frontend/src/assets/game/*.js
frontend/src/assets/game/*.wasm
frontend/src/assets/game/*.pck
frontend/src/assets/game/*.png

# Angular
frontend/node_modules/
frontend/dist/
frontend/.angular/
# ng-openapi-gen output — generated from openapi.json at build/gen-api time
frontend/src/app/api/

# Spring Boot
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# Casdoor — rendered init_data is generated at container startup from the .tpl template.
# Never commit the rendered file; it bakes in default / rotated secrets.
casdoor/init_data.json

# Frontend OpenAPI spec — regenerated from the live backend via `make gen-api`.
frontend/openapi.json

# E2E artifacts — certs are generated by scripts/gen-certs.sh on every `make e2e`,
# results are Playwright traces/screenshots/videos written by the test container.
e2e/certs/
e2e/results/
e2e/node_modules/

# Claude Code agent harness — runtime lock files for scheduled tasks.
.claude/

# Publishing pipeline output (LaTeX PDF + PowerPoints + themed Javadoc).
# Sources are under docs/publishing/; rebuild with `make docs-all`.
docs/publishing/architecture/build/
docs/publishing/architecture/*.aux
docs/publishing/architecture/*.log
docs/publishing/architecture/*.toc
docs/publishing/architecture/*.out
docs/publishing/architecture/chapters/*.aux
docs/publishing/architecture/diagrams/*.aux
docs/publishing/slides/build/
docs/publishing/javadoc-output/
docs/publishing/scripts/pre-push.sample
docs/publishing/slides/__pycache__/

# Rendered TikZ diagrams + marble PNGs (regenerated from the .tex sources).
docs/publishing/diagrams-rendered/build/

# Selenium-captured UI screenshots (or placeholder PNGs when compose is down).
docs/publishing/screenshots/build/

# Per-guide build outputs.
docs/publishing/userguides/*/build/

# OpenAPI build outputs (merged spec + per-tag LaTeX fragments).
docs/publishing/openapi/build/
docs/publishing/architecture/openapi-summary.tex

# Documentation bundle zip (produced by `make docs-bundle`).
# Current path: docs/hugmesh-design-docs-<YYYY-MM-DDTHHMMSSZ>.zip
# Legacy path (pre-docs-zip-relocate): /hugmesh-docs-<DATE>.zip
docs/hugmesh-design-docs-*.zip
/hugmesh-docs-*.zip

# Per-build stamp file regenerated by `make` on every doc build so the
# LaTeX, slide-deck, and Javadoc artefacts share one project + datetime.
docs/publishing/architecture/build-stamp.tex
/.env

# Marble-diagram intermediate PNGs (rendered by render-all.sh).
docs/publishing/architecture/marbles/build/

# playwright-bdd generated specs (regenerated from features/*.feature
# on every run via the `bddgen` step in e2e/Dockerfile).
e2e/.features-gen/

# Per-service Maven build output
rpg-builder/target/
vn-builder/target/

# Per-game synced addon copies — populated by `make sync-bridge-addon`
games/*/addons/hugmesh_bridge/
games/dodecahedron-demo/addons/hugmesh_bridge/
games/three-wizards-in-a-trenchcoat/addons/hugmesh_bridge/
