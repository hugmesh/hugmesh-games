# Godot 4+
.godot/
.nomedia
.import/
export.cfg
export_credentials.cfg
*.translation
.mono/
data_*/
mono_crash.*.json

# Rust
game/rust/target/
godot-project/rust_extension/bin/*.so
godot-project/rust_extension/bin/*.dll
godot-project/rust_extension/bin/*.dylib
godot-project/rust_extension/bin/*.wasm

# Godot web export output (generated by build)
frontend/src/assets/game/*.html
frontend/src/assets/game/*.js
frontend/src/assets/game/*.wasm
frontend/src/assets/game/*.pck
frontend/src/assets/game/*.png

# Angular
frontend/node_modules/
frontend/dist/
frontend/.angular/
# ng-openapi-gen output — generated from openapi.json at build/gen-api time
frontend/src/app/api/

# Spring Boot
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# Casdoor — rendered init_data is generated at container startup from the .tpl template.
# Never commit the rendered file; it bakes in default / rotated secrets.
casdoor/init_data.json

# Frontend OpenAPI spec — regenerated from the live backend via `make gen-api`.
frontend/openapi.json
