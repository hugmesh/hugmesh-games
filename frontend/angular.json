		"hugmesh-games-frontend": {
			"projectType": "application",
			"schematics": {},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "hugmesh-games-frontend:esbuild:production",
						"entryPoints": [
							"src/main.ts"
						],
						"projectName": "hugmesh-games-frontend"
					},
					"configurations": {
						"development": {
							"target": "hugmesh-games-frontend:esbuild:development",
							"dev": true
						},
						"production": {
							"target": "hugmesh-games-frontend:esbuild:production"
						}
					},
					"defaultConfiguration": "production"
				},
				"esbuild": {
					"builder": "@angular-devkit/build-angular:application",
					"options": {
						"outputPath": "dist/hugmesh-games-frontend",
						"index": "src/index.html",
						"browser": "src/main.ts",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "src/assets",
								"output": "assets"
							}
						],
						"styles": [
							"src/styles.scss"
						],
						"scripts": []
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kb",
									"maximumError": "1mb"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "8kb",
									"maximumError": "16kb"
								}
							],
							"outputHashing": "all",
							"fileReplacements": [
								{
									"replace": "src/environments/environment.ts",
									"with": "src/environments/environment.prod.ts"
								}
							]
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-devkit/build-angular:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "hugmesh-games-frontend:esbuild:production"
						},
						"development": {
							"buildTarget": "hugmesh-games-frontend:esbuild:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"proxyConfig": "proxy.conf.js",
						"headers": {
							"Cross-Origin-Opener-Policy": "same-origin",
							"Cross-Origin-Embedder-Policy": "require-corp"
						}
					}
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "tsconfig.spec.json",
						"karmaConfig": "karma.conf.js",
						"assets": [
							{
								"glob": "**/*",
								"input": "src/assets",
								"output": "assets"
							}
						],
						"styles": [
							"src/styles.scss"
						],
						"scripts": []
					}
				}
			}
		},
