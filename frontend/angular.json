{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"login": {
			"projectType": "application",
			"schematics": {},
			"root": "projects/login",
			"sourceRoot": "projects/login/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "login:esbuild:production",
						"entryPoints": [
							"projects/login/src/main.ts"
						],
						"projectName": "login"
					},
					"configurations": {
						"development": {
							"target": "login:esbuild:development",
							"dev": true
						},
						"production": {
							"target": "login:esbuild:production"
						}
					},
					"defaultConfiguration": "production"
				},
				"esbuild": {
					"builder": "@angular-devkit/build-angular:application",
					"options": {
						"outputPath": "dist/login",
						"index": "projects/login/src/index.html",
						"browser": "projects/login/src/main.ts",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "projects/login/tsconfig.app.json",
						"assets": [],
						"styles": [],
						"scripts": []
					},
					"configurations": {
						"production": {
							"outputHashing": "none",
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kb",
									"maximumError": "2mb"
								}
							]
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				}
			}
		},
