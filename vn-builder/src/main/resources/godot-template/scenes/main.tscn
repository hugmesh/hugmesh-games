[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/scene_player.gd" id="1"]
[ext_resource type="Script" path="res://scripts/text_box.gd" id="2"]

; The VN bundle's root is a Node3D — even a "2D" visual novel ships
; as a 3D scene so snapdragon-bridge's MultiplayerLobby + per-player
; view channel can render avatars in the same space the dialogue
; plays out in. The visible VN surface is a flat QuadMesh layered
; against a simple 3D-primitive backdrop (BoxMesh). BackgroundCube and
; Foreground start mesh-less; scene_player.gd assigns a mesh + an
; unshaded ImageTexture material at load time when the active scene's
; background / speaking character carries a materialized asset (see
; scene_player.gd `_load_texture`). SVG assets are decoded via
; Image.load_svg_from_buffer so they stay resolution-independent.

[node name="ScenePlayer" type="Node3D"]
script = ExtResource("1")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 4)

; 3D background layer — simple primitives you can rotate / parallax
; under the dialogue plane. Replaced at build time when the project
; defines a Background asset.
[node name="BackgroundCube" type="MeshInstance3D" parent="."]
transform = Transform3D(2, 0, 0, 0, 1.4, 0, 0, 0, 0.1, 0, 0.4, -2)

; Flat foreground plane that displays the active scene's portrait /
; background SVG (rendered via SubViewport when present).
[node name="Foreground" type="MeshInstance3D" parent="."]
transform = Transform3D(2, 0, 0, 0, 1.2, 0, 0, 0, 1, 0, 0, 0)

[node name="Wizards" type="Node3D" parent="."]

[node name="MultiplayerLobby" type="SnapdragonMultiplayerLobby" parent="."]
avatar_parent_path = NodePath("../Wizards")

; Dialogue UI overlays the 3D space via a CanvasLayer so the text
; box stays screen-locked while the camera dollies through the 3D
; backgrounds behind.
[node name="UI" type="CanvasLayer" parent="."]

[node name="TextBox" type="Panel" parent="UI"]
script = ExtResource("2")
anchor_top = 0.7
anchor_right = 1.0
anchor_bottom = 1.0
