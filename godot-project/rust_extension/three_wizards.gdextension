[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64    = "res://rust_extension/bin/libthree_wizards.so"
linux.release.x86_64  = "res://rust_extension/bin/libthree_wizards.so"
windows.debug.x86_64  = "res://rust_extension/bin/three_wizards.dll"
windows.release.x86_64= "res://rust_extension/bin/three_wizards.dll"
macos.debug           = "res://rust_extension/bin/libthree_wizards.dylib"
macos.release         = "res://rust_extension/bin/libthree_wizards.dylib"
; Web/wasm — needs emscripten + cargo target wasm32-unknown-emscripten.
; The Makefile's build-rust target attempts this and falls through with a
; warning if emscripten isn't installed. Without these entries Godot's web
; export logs "no library matching this platform" every boot when
; extensions_support=true; the export presets currently disable it for
; that reason, but keeping these entries means a future emscripten build
; just works without manifest changes.
web.debug.wasm32      = "res://rust_extension/bin/three_wizards.wasm"
web.release.wasm32    = "res://rust_extension/bin/three_wizards.wasm"
