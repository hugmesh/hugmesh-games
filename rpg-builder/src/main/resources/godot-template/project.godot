; Generated Godot 4 project for snapdragon-rpg-builder.
;
; The build worker writes this file once per build into the working
; directory, with {{slug}} and {{displayName}} interpolated. The
; addon-list pulls in snapdragon_bridge so the produced WASM exposes
; the Rust HostBridge / multiplayer lobby / per-player view channel
; the host portal expects.

config_version=5

[application]

config/name="{{displayName}}"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/snapdragon_bridge/plugin.cfg")

[gdextension]

scan_for_extensions=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
