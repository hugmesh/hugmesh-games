<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="003-build-jobs" author="hugmesh-rpg-builder">
    <!--
      The frontend POSTs /api/rpg/projects/{id}/build to enqueue a row;
      the GodotCompileWorker @Scheduled tick claims `queued` rows
      atomically (UPDATE … WHERE status='queued' RETURNING …) and walks
      the project tree → renders Godot template → invokes Godot CLI in a
      sibling docker container → zips the bundle → POSTs to the BFF
      upload endpoint with the building user's bearer token. The
      frontend polls /api/rpg/builds/{buildId} for progress + log_tail.
    -->
    <createTable tableName="rpg_build_jobs">
      <column name="id"                 type="uuid"        defaultValueComputed="uuid_generate_v4()"><constraints primaryKey="true" nullable="false"/></column>
      <column name="project_id"         type="uuid"><constraints nullable="false" foreignKeyName="fk_rpg_build_jobs_project" references="rpg_projects(id)" deleteCascade="true"/></column>
      <column name="status"             type="varchar(16)" defaultValue="QUEUED"><constraints nullable="false"/></column>
      <column name="progress_pct"       type="integer"     defaultValueNumeric="0"><constraints nullable="false"/></column>
      <column name="log_tail"           type="text"        defaultValue=""><constraints nullable="false"/></column>
      <column name="target_slug"        type="varchar(64)"><constraints nullable="false"/></column>
      <column name="output_zip_path"    type="varchar(512)"/>
      <column name="error_message"      type="text"/>
      <column name="owner_casdoor_id"   type="varchar(64)"><constraints nullable="false"/></column>
      <!-- Bearer token forwarded from the originating request so the
           worker can re-authenticate against the BFF as the user. The
           token is short-lived; a queued build that misses its
           expiration window fails fast with HTTP 401 and leaves a
           clean error_message for the frontend. -->
      <column name="bearer_token"       type="text"><constraints nullable="false"/></column>
      <column name="created_at"         type="timestamp with time zone" defaultValueComputed="now()"><constraints nullable="false"/></column>
      <column name="started_at"         type="timestamp with time zone"/>
      <column name="finished_at"        type="timestamp with time zone"/>
    </createTable>

    <sql>
      ALTER TABLE rpg_build_jobs
        ADD CONSTRAINT ck_rpg_build_jobs_status
        CHECK (status IN ('QUEUED','RENDERING','EXPORTING','UPLOADING','DONE','FAILED'));
    </sql>

    <createIndex tableName="rpg_build_jobs" indexName="idx_rpg_build_jobs_project">
      <column name="project_id"/>
    </createIndex>
    <createIndex tableName="rpg_build_jobs" indexName="idx_rpg_build_jobs_status">
      <column name="status"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
