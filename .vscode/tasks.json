{
  "version": "2.0.0",
  "tasks": [

    // ── Full build chain ──────────────────────────────────────────────────
    {
      "label": "Build: All",
      "type": "shell",
      "command": "make build",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$rustc", "$tsc", "$javac"]
    },
    {
      "label": "Clean: All",
      "type": "shell",
      "command": "make clean",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    // ── Rust ─────────────────────────────────────────────────────────────
    {
      "label": "Build: Rust GDExtension",
      "type": "shell",
      "command": "make build-rust",
      "group": "build",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "rust" },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Cargo: Check",
      "type": "shell",
      "command": "cargo check",
      "options": { "cwd": "${workspaceFolder}/game/rust" },
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "dedicated", "group": "rust" },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Cargo: Clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets -- -D warnings",
      "options": { "cwd": "${workspaceFolder}/game/rust" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "rust" },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Cargo: Test",
      "type": "shell",
      "command": "cargo test",
      "options": { "cwd": "${workspaceFolder}/game/rust" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "rust" },
      "problemMatcher": "$rustc"
    },

    // ── Godot ────────────────────────────────────────────────────────────
    {
      "label": "Build: Godot Web Export",
      "type": "shell",
      "command": "make build-godot",
      "group": "build",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "godot" },
      "problemMatcher": []
    },
    {
      "label": "Godot: Open Editor",
      "type": "shell",
      "command": "godot --editor godot-project/project.godot &",
      "group": "none",
      "presentation": { "reveal": "silent", "panel": "dedicated", "group": "godot" },
      "problemMatcher": []
    },

    // ── Spring Boot API ───────────────────────────────────────────────────
    {
      "label": "Build: Backend JAR",
      "type": "shell",
      "command": "make build-backend",
      "group": "build",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "problemMatcher": "$javac"
    },
    {
      "label": "Dev: Spring Boot API",
      "type": "shell",
      "command": "make dev-backend",
      "group": "none",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend",
        "label": "Spring Boot"
      },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting ThreeWizardsApplication",
          "endsPattern": "Started ThreeWizardsApplication"
        }
      }
    },
    {
      "label": "Dev: Spring Boot API (suspend on start — attach debugger)",
      "type": "shell",
      "command": "cd backend && ./mvnw spring-boot:run -Dspring-boot.run.jvmArguments='-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005'",
      "group": "none",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend",
        "label": "Spring Boot (debug)"
      },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Listening for transport dt_socket",
          "endsPattern": "Listening for transport dt_socket"
        }
      }
    },
    {
      "label": "Maven: Test",
      "type": "shell",
      "command": "./mvnw test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "problemMatcher": "$javac"
    },

    // ── Angular Frontend ──────────────────────────────────────────────────
    {
      "label": "Build: Angular (production)",
      "type": "shell",
      "command": "make build-frontend",
      "group": "build",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "frontend" },
      "problemMatcher": "$tsc"
    },
    {
      "label": "Dev: Angular (npm start)",
      "type": "shell",
      "command": "make dev-frontend",
      "group": "none",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend",
        "label": "Angular"
      },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Local:.*http://localhost"
        }
      }
    },
    {
      "label": "npm: Install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "frontend" },
      "problemMatcher": []
    }
  ]
}
