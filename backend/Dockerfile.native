# GraalVM native-image build of the HugMesh Gaming BFF.
# Drop-in replacement for backend/Dockerfile — same listening port, same
# config file resolution, same env vars. Tradeoffs:
#
#   ✓ Cold start ~50–100 ms (vs ~3 s on the JVM)
#   ✓ RSS ~100 MB (vs ~400 MB)
#   ✓ Final image ~150 MB (vs ~430 MB on eclipse-temurin:25-jre)
#   ✗ Build is slow (~5–10 min) and memory-hungry (~6–8 GB)
#   ✗ No JIT / class hot-swap; reflection requires explicit hints
#     (see backend/src/main/java/games/hugmesh/bff/aot/HugMeshRuntimeHints.java)
#
# Build standalone:
#   docker build -f backend/Dockerfile.native -t hugmesh-gaming-bff:native ./backend
#
# Build via make (preferred — caches Maven offline deps):
#   make build-backend-native
#
# The JVM Dockerfile (backend/Dockerfile) is still the default for `make e2e`
# and the docker-compose build until native is proven across the full stack.
# See docs/PLAN-module-federation-and-native.md (section D) for the rollout
# plan + open issues.

# GraalVM CE 25.0.2 for JDK 25, pinned by digest. The pom compiles for Java 25
# (<java.version>25</java.version>), which the earlier native-image-community:21 could
# not build. It also stays clear of Java4Shell (CVE-2026-114938): GraalVM's compiler
# ported HotSpot's AVX-512 Base64 decode stub (oracle/graal 040cfd0a8a, 2026-03-24)
# and SubstrateVM compiles it into amd64 native images. The fix (oracle/graal
# 13a4853144, GR-79579) is on master only, and every GraalVM 25 Innovation release
# through 25.5.5.0.3 still ships the unfixed stub. 25.0.2 predates the port. The RUN
# below refuses any other toolchain until one is confirmed to contain GR-79579.
FROM ghcr.io/graalvm/native-image-community:25@sha256:0d936f32bb8acb5bc60c41b33e05f064d7a6aaf36b726538296c54949bd4a3c0 AS build
RUN grep -qx 'GRAALVM_VERSION="25.0.2"' "${JAVA_HOME}/release" \
    || { echo "GraalVM $(sed -n 's/^GRAALVM_VERSION=//p' "${JAVA_HOME}/release") is not on the Java4Shell (CVE-2026-114938) allowlist; see the comment above" >&2; exit 1; }

# Passed through to native-image (GraalVM reads NATIVE_IMAGE_OPTIONS), e.g.
# --build-arg NATIVE_IMAGE_OPTIONS=-J-Xmx6g on a shared host. Empty = native-image's
# default heap (80% of RAM).
ARG NATIVE_IMAGE_OPTIONS=""
ENV NATIVE_IMAGE_OPTIONS=${NATIVE_IMAGE_OPTIONS}

# native-image's bundled Maven is fine, but we use the project's mvnw to
# stay version-locked with what `mvn package` builds on the JVM side.
WORKDIR /app
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN ./mvnw -B -q dependency:go-offline

COPY src src

# `process-aot` runs first (handled by spring-boot-maven-plugin under the
# `native` profile), then `native:compile` produces the binary. -DskipTests
# matches the JVM build; the unit tests run separately via `make test-backend`.
RUN ./mvnw -B -Pnative -DskipTests native:compile

# Slim runtime stage — debian:bookworm-slim has libc + the few system libs
# the native binary needs. distroless is even smaller but lacks bash for
# debugging. Revisit once the native build is stable.
FROM debian:bookworm-slim

# `wget` is needed by the make e2e-native wait loop's health check
# (`docker compose exec api sh -c 'wget -qO- http://localhost:8080/actuator/health'`).
# ca-certificates so the binary can verify the Casdoor JWKS endpoint
# over HTTPS once we move that off http://casdoor:8000.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/target/hugmesh-gaming-bff app.bin

EXPOSE 8080
ENTRYPOINT ["/app/app.bin"]
