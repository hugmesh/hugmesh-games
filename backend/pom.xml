<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.0</version>
    <relativePath/>
  </parent>

  <groupId>games.snapdragon</groupId>
  <artifactId>snapdragon-gaming-bff</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>snapdragon-gaming-bff</name>
  <description>Snapdragon Gaming BFF — backend-for-frontend that delivers the Snapdragon Games portal (game catalog, sessions, SSE state stream, asset bundles).</description>
  <packaging>jar</packaging>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>

    <!-- WebFlux — reactive HTTP -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- AWS S3 v2 (object-storage strategy for game uploads).
         Used when app.uploads.storage=s3 — points at MinIO in dev,
         a real S3 bucket in prod. The filesystem strategy stays the
         default to avoid breaking compose-up-without-MinIO flows. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.31.0</version>
      <!-- Exclude the AWS SDK's default Netty client; we already have
           Reactor Netty from WebFlux and don't want two HTTP stacks
           in the JVM. Falls back to URL-connection-based client. -->
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
      <version>2.31.0</version>
    </dependency>

    <!-- R2DBC — reactive non-blocking data access -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-r2dbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>r2dbc-postgresql</artifactId>
    </dependency>

    <!-- Cassandra reactive — cross-pod session/cache layer (active sessions,
         controller leases, pod heartbeats). See docker/cassandra-init.cql. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-cassandra-reactive</artifactId>
    </dependency>

    <!-- Spring Kafka — streaming audit + telemetry pipeline (decision 021).
         Producer side only in this PR; ClickHouse consumes via its built-in
         Kafka engine table so the BFF doesn't ship a separate consumer
         service. Disabled by default (app.kafka.enabled=false) so vanilla
         compose-up keeps working without the Kafka container. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- JDBC (DataSource only) — used exclusively by Liquibase -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Liquibase — schema migrations via JDBC DataSource -->
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
    </dependency>

    <!-- Security — WebFlux reactive security -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- OAuth2 Resource Server — validate Casdoor-issued JWTs -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- SpringDoc — generates OpenAPI 3 spec at /v3/api-docs (consumed by ng-openapi-gen) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
      <version>2.7.0</version>
    </dependency>

    <!-- Actuator -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers — used by GameUploadIntegrationTest only.
         Pinned past 1.21.0 so the bundled docker-java client speaks
         the API the modern Docker daemon requires (the BOM defaults
         in Spring Boot 3.4 pull 1.20.4 which speaks API 1.32 and
         Docker 29+ rejects). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>1.21.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>1.21.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Chicory — pure-Java (zero-native-dependency) WebAssembly runtime.
         Runs the SAME wasm32 sim-core bytes the browser executes, in-JVM,
         behind the SimCore / SimCoreFactory boundary (P4 spike, decision
         docs/realtime-sim-wiring-p4.md option A). `runtime` is the
         interpreter + Instance/Memory marshalling API; `wasm` is the
         binary parser (Parser.parse(byte[]) -> WasmModule).

         Test-scoped for the spike: the only .wasm we have lives under
         src/test/resources/wasm/. Promoting WasmSimCore(Factory) to main/
         is: (1) move these two deps to default (compile) scope, (2) move
         the two classes from src/test/.../realtime/wasm/ to the matching
         src/main path, (3) annotate WasmSimCoreFactory @Component so Spring
         registers it in AuthoritativeTickService's factory map, and (4)
         load the .wasm from the same upload store wasm-fragment serves
         instead of the test classpath. No code change to the marshalling
         path is needed — only the module-bytes source. Latest stable at
         time of writing is 1.7.5 (Maven Central, 2026-03). -->
    <dependency>
      <groupId>com.dylibso.chicory</groupId>
      <artifactId>runtime</artifactId>
      <version>1.7.5</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.dylibso.chicory</groupId>
      <artifactId>wasm</artifactId>
      <version>1.7.5</version>
      <scope>test</scope>
    </dependency>

    <!-- spring-kafka-test — provides @EmbeddedKafka for the
         TwoPodKafkaCrossPodIT integration test (decision-021
         follow-up). Spins up an in-process Kafka broker so the
         producer ↔ subscriber wiring can be exercised end-to-end
         without docker. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- BouncyCastle — supplies the SHA3 digests we use to derive
         every UI-facing UID (launch tokens, session ids, pod ids)
         and the SP800-90A HMAC-SHA256 DRBG that backs the Crypto
         utility's SecureRandom. JDK ships its own SHA3 impl on
         Java 9+ but BC's algorithm coverage stays consistent across
         JDK upgrades + native-image (where the JCA service-loader
         can be picky). -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.78.1</version>
    </dependency>

    <!-- Resilience4j circuit breaker — wraps Cassandra-backed
         RevocationListService refresh + DistributedRateLimitService
         calls so a slow Cassandra doesn't pile up rate-limit checks
         on the hot path. Same artefact + same `casdoor` /
         `revocation` instance names the snapdragon-gateway uses for
         its corresponding cache services. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
      <version>2.2.0</version>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>games.snapdragon.bff.SnapdragonGamesBffApplication</mainClass>
        </configuration>
      </plugin>
      <!--
        Themed Javadoc generation. Driven by `make docs-javadocs` from the
        repo root, which sets `additionalparam` to override the doclet's
        stylesheet and header/footer with the Snapdragon brand assets under
        docs/publishing/javadoc-theme/. The plugin stays bound to no phase
        on purpose — the Make target invokes `mvn javadoc:javadoc` directly
        so the regular `mvn package` build doesn't pay the Javadoc cost.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <doctitle>Snapdragon Games &mdash; Snapdragon Gaming BFF API</doctitle>
          <windowtitle>Snapdragon Gaming BFF</windowtitle>
          <bottom><![CDATA[
            <div class="snap-footer">
              <strong>Snapdragon Games</strong> &middot;
              <a href="https://github.com/Snapdragon-Systems/snapdragon.games">repository</a>
              &middot;
              <a href="https://github.com/Snapdragon-Systems/snapdragon.games/blob/main/docs/publishing/architecture/architecture.tex">architecture (PDF)</a>
              &middot;
              <a href="https://github.com/Snapdragon-Systems/snapdragon.games/blob/main/README.md">README</a>
            </div>
          ]]></bottom>
          <header><![CDATA[
            <div class="snap-brand-strip">
              <div class="snap-mark">
                <strong>Snapdragon Games</strong>
                <span>API Reference</span>
              </div>
              <div class="snap-meta">
                snapdragon.games &middot;
                <a href="https://github.com/Snapdragon-Systems/snapdragon.games">github</a>
              </div>
            </div>
          ]]></header>
          <!--
            Snapdragon Games stylesheet. The maven-javadoc-plugin's
            addStylesheets element resolves paths against src/main/javadoc/,
            but the canonical theme lives under docs/publishing/javadoc-theme/.
            We pass the raw javadoc tool flag below (add-stylesheet) so we
            can use an absolute path; the Make target copies the file into
            the output dir alongside the generated HTML so the link works.
          -->
          <failOnError>false</failOnError>
          <failOnWarnings>false</failOnWarnings>
          <quiet>true</quiet>
          <doclint>none</doclint>
          <additionalOptions>
            <additionalOption>--allow-script-in-comments</additionalOption>
            <additionalOption>--add-stylesheet</additionalOption>
            <additionalOption>${project.basedir}/../docs/publishing/javadoc-theme/snapdragon.css</additionalOption>
          </additionalOptions>
          <links>
            <link>https://docs.spring.io/spring-framework/docs/current/javadoc-api/</link>
            <link>https://docs.spring.io/spring-boot/docs/current/api/</link>
            <link>https://projectreactor.io/docs/core/release/api/</link>
          </links>
        </configuration>
      </plugin>
      <!-- Byte Buddy (via Mockito) only officially supports up to JDK 23; this
           enables it to run on newer JDKs (the build host runs Temurin 25). A
           no-op on JDK <=23, so it is safe for the Java 21 target too. Same
           convention as rpg-builder / vn-builder / the snapdragon-*-bff-api
           repos. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dnet.bytebuddy.experimental=true</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    `mvn -Pnative native:compile` produces a single statically-linked binary
    from the Spring Boot app — sub-second cold start, ~100 MB RSS, ~150 MB
    container instead of the JRE-based ~400 MB image. The JVM build
    (`mvn package`) keeps working as the default; use the native profile
    only when you've got 6–8 GB of RAM available for the AOT compiler.

    See `backend/Dockerfile.native` for the matching multi-stage build and
    `make build-backend-native` for the convenience wrapper.

    Phase-2 plan: docs/PLAN-module-federation-and-native.md (section D).
  -->
  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>process-aot</id>
                <goals><goal>process-aot</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <!--
                Classes that need RUNTIME init (cannot be pre-initialised at
                build time). The list grows as new third-party libs surface
                their JIT-only invariants. Discovered via runtime
                NoClassDefFoundError or "Class initialization is not yet
                supported within native-image" trace.
              -->
              <buildArgs>
                <buildArg>--initialize-at-run-time=org.fusesource.jansi.AnsiConsole</buildArg>
                <!--
                  Netty's jctools-shaded MPSC queues read thread-local +
                  Unsafe state in their static initialiser, so build-time
                  init can leave them in an "init failed" state that
                  manifests at runtime as NoClassDefFoundError when the
                  Cassandra reactive driver's frame encoder allocates a
                  buffer. Defer ALL of jctools (broad package) to
                  runtime — same workaround Spring's docs recommend for
                  Cassandra + R2DBC reactive stacks under native-image.
                -->
                <buildArg>--initialize-at-run-time=io.netty.util.internal.shaded.org.jctools</buildArg>
                <!--
                  Per-level Godot bundles ship as classpath resources
                  under `assets/levels/<slug>/`. native-image strips
                  classpath resources by default; AssetController returns
                  404 without explicit inclusion. -H: pattern matches
                  the FULL classpath path (no leading slash).
                -->
                <buildArg>-H:IncludeResources=assets/.*</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
