<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.0</version>
    <relativePath/>
  </parent>

  <groupId>games.snapdragon</groupId>
  <artifactId>snapdragon-gaming-bff</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>snapdragon-gaming-bff</name>
  <description>Snapdragon Gaming BFF — backend-for-frontend that delivers the Snapdragon Games portal (game catalog, sessions, SSE state stream, asset bundles).</description>
  <packaging>jar</packaging>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>

    <!-- WebFlux — reactive HTTP -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- R2DBC — reactive non-blocking data access -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-r2dbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>r2dbc-postgresql</artifactId>
    </dependency>

    <!-- Cassandra reactive — cross-pod session/cache layer (active sessions,
         controller leases, pod heartbeats). See docker/cassandra-init.cql. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-cassandra-reactive</artifactId>
    </dependency>

    <!-- JDBC (DataSource only) — used exclusively by Liquibase -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Liquibase — schema migrations via JDBC DataSource -->
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
    </dependency>

    <!-- Security — WebFlux reactive security -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- OAuth2 Resource Server — validate Casdoor-issued JWTs -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- SpringDoc — generates OpenAPI 3 spec at /v3/api-docs (consumed by ng-openapi-gen) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
      <version>2.7.0</version>
    </dependency>

    <!-- Actuator -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers — used by GameUploadIntegrationTest only.
         Pinned past 1.21.0 so the bundled docker-java client speaks
         the API the modern Docker daemon requires (the BOM defaults
         in Spring Boot 3.4 pull 1.20.4 which speaks API 1.32 and
         Docker 29+ rejects). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>1.21.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>1.21.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>games.snapdragon.bff.SnapdragonBffApplication</mainClass>
        </configuration>
      </plugin>
      <!--
        Themed Javadoc generation. Driven by `make docs-javadocs` from the
        repo root, which sets `additionalparam` to override the doclet's
        stylesheet and header/footer with the Snapdragon brand assets under
        docs/publishing/javadoc-theme/. The plugin stays bound to no phase
        on purpose — the Make target invokes `mvn javadoc:javadoc` directly
        so the regular `mvn package` build doesn't pay the Javadoc cost.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <doctitle>Snapdragon Games &mdash; Snapdragon Gaming BFF API</doctitle>
          <windowtitle>Snapdragon Gaming BFF</windowtitle>
          <bottom><![CDATA[
            <div class="snap-footer">
              <strong>Snapdragon Games</strong> &middot;
              <a href="https://github.com/Snapdragon-Systems/ThreeWizardsInATrenchcoat">repository</a>
              &middot;
              <a href="https://github.com/Snapdragon-Systems/ThreeWizardsInATrenchcoat/blob/main/docs/publishing/architecture/architecture.tex">architecture (PDF)</a>
              &middot;
              <a href="https://github.com/Snapdragon-Systems/ThreeWizardsInATrenchcoat/blob/main/README.md">README</a>
            </div>
          ]]></bottom>
          <header><![CDATA[
            <div class="snap-brand-strip">
              <div class="snap-mark">
                <strong>Snapdragon Games</strong>
                <span>API Reference</span>
              </div>
              <div class="snap-meta">
                Three Wizards In A Trenchcoat &middot;
                <a href="https://github.com/Snapdragon-Systems/ThreeWizardsInATrenchcoat">github</a>
              </div>
            </div>
          ]]></header>
          <!--
            Snapdragon Games stylesheet. The maven-javadoc-plugin's
            addStylesheets element resolves paths against src/main/javadoc/,
            but the canonical theme lives under docs/publishing/javadoc-theme/.
            We pass the raw javadoc tool flag below (add-stylesheet) so we
            can use an absolute path; the Make target copies the file into
            the output dir alongside the generated HTML so the link works.
          -->
          <failOnError>false</failOnError>
          <failOnWarnings>false</failOnWarnings>
          <quiet>true</quiet>
          <doclint>none</doclint>
          <additionalOptions>
            <additionalOption>--allow-script-in-comments</additionalOption>
            <additionalOption>--add-stylesheet</additionalOption>
            <additionalOption>${project.basedir}/../docs/publishing/javadoc-theme/snapdragon.css</additionalOption>
          </additionalOptions>
          <links>
            <link>https://docs.spring.io/spring-framework/docs/current/javadoc-api/</link>
            <link>https://docs.spring.io/spring-boot/docs/current/api/</link>
            <link>https://projectreactor.io/docs/core/release/api/</link>
          </links>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    `mvn -Pnative native:compile` produces a single statically-linked binary
    from the Spring Boot app — sub-second cold start, ~100 MB RSS, ~150 MB
    container instead of the JRE-based ~400 MB image. The JVM build
    (`mvn package`) keeps working as the default; use the native profile
    only when you've got 6–8 GB of RAM available for the AOT compiler.

    See `backend/Dockerfile.native` for the matching multi-stage build and
    `make build-backend-native` for the convenience wrapper.

    Phase-2 plan: docs/PLAN-module-federation-and-native.md (section D).
  -->
  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>process-aot</id>
                <goals><goal>process-aot</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <!--
                Classes that need RUNTIME init (cannot be pre-initialised at
                build time). The list grows as new third-party libs surface
                their JIT-only invariants. Discovered via runtime
                NoClassDefFoundError or "Class initialization is not yet
                supported within native-image" trace.
              -->
              <buildArgs>
                <buildArg>--initialize-at-run-time=org.fusesource.jansi.AnsiConsole</buildArg>
                <!--
                  Netty's jctools-shaded MPSC queues read thread-local +
                  Unsafe state in their static initialiser, so build-time
                  init can leave them in an "init failed" state that
                  manifests at runtime as NoClassDefFoundError when the
                  Cassandra reactive driver's frame encoder allocates a
                  buffer. Defer ALL of jctools (broad package) to
                  runtime — same workaround Spring's docs recommend for
                  Cassandra + R2DBC reactive stacks under native-image.
                -->
                <buildArg>--initialize-at-run-time=io.netty.util.internal.shaded.org.jctools</buildArg>
                <!--
                  Per-level Godot bundles ship as classpath resources
                  under `assets/levels/<slug>/`. native-image strips
                  classpath resources by default; AssetController returns
                  404 without explicit inclusion. -H: pattern matches
                  the FULL classpath path (no leading slash).
                -->
                <buildArg>-H:IncludeResources=assets/.*</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
