<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <!--
    Domain rename pass:
      level   → chapter   (game stage; the player_characters.level XP
                            field stays as-is — that's experience level)
      spell   → instant   (skills.skill_type and the cast action verb)

    The migration only touches schema names + the small set of seed
    string-literal values that flip (skill_type='spell' → 'instant').
    Per-character XP `level` columns stay; "log level" stays.
  -->

  <changeSet id="028-1-rename-levels-table" author="nin">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="levels"/>
    </preConditions>
    <renameTable oldTableName="levels" newTableName="chapters"/>
  </changeSet>

  <changeSet id="028-2-rename-level-assets-table" author="nin">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="level_assets"/>
    </preConditions>
    <renameTable oldTableName="level_assets" newTableName="chapter_assets"/>
  </changeSet>

  <changeSet id="028-3-rename-level-id-on-chapter-assets" author="nin">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="chapter_assets" columnName="level_id"/>
    </preConditions>
    <renameColumn tableName="chapter_assets"
                  oldColumnName="level_id" newColumnName="chapter_id"/>
  </changeSet>

  <changeSet id="028-4-rename-current-level-id-on-characters" author="nin">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="player_characters" columnName="current_level_id"/>
    </preConditions>
    <renameColumn tableName="player_characters"
                  oldColumnName="current_level_id" newColumnName="current_chapter_id"/>
  </changeSet>

  <!-- Liquibase 027 already named the column level_id; flip it to
       chapter_id for the post-rename naming. -->
  <changeSet id="028-5-rename-level-id-on-positions" author="nin">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="player_positions" columnName="level_id"/>
    </preConditions>
    <renameColumn tableName="player_positions"
                  oldColumnName="level_id" newColumnName="chapter_id"/>
  </changeSet>

  <changeSet id="028-6-flip-spell-to-instant-in-skills" author="nin">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="skills"/>
      <columnExists tableName="skills" columnName="skill_type"/>
    </preConditions>
    <update tableName="skills">
      <column name="skill_type" value="instant"/>
      <where>skill_type = 'spell'</where>
    </update>
  </changeSet>

  <!-- Update game.features default + seeds: spell_loadout flag → instant_loadout.
       Liquibase routes <sql> through the JDBC PreparedStatement layer,
       which treats `?` as a parameter placeholder and reports
       "syntax error at or near $1" the moment it sees the JSONB
       key-exists operator (`features ? 'spell_loadout'`).
       Use `jsonb_exists(features, 'spell_loadout')` instead — same
       semantics, no `?` to confuse the binder. -->
  <changeSet id="028-7-flip-features-spell-loadout-key" author="nin">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="games" columnName="features"/>
    </preConditions>
    <sql>
      UPDATE games
      SET features = (features - 'spell_loadout')
                     || jsonb_build_object('instant_loadout', features->'spell_loadout')
      WHERE jsonb_exists(features, 'spell_loadout');
    </sql>
  </changeSet>

  <!-- Rename composite-unique constraint on chapter_assets — Liquibase
       auto-named the original on the (level_id, label) tuple. Drop +
       re-add under the chapter_-prefixed name to keep introspection
       readable. -->
  <changeSet id="028-8-rename-chapter-assets-unique" author="nin">
    <preConditions onFail="MARK_RAN" onFailMessage="legacy unique already renamed">
      <sqlCheck expectedResult="1">
        SELECT COUNT(*) FROM information_schema.table_constraints
        WHERE table_name = 'chapter_assets'
          AND constraint_name = 'uq_level_assets_label'
          AND constraint_type = 'UNIQUE'
      </sqlCheck>
    </preConditions>
    <sql>ALTER TABLE chapter_assets RENAME CONSTRAINT uq_level_assets_label TO uq_chapter_assets_label</sql>
  </changeSet>

  <!-- 028-9 catches the `level_prerequisites` table missed by the
       original 028 sweep. Symptom in production was an R2DBC
       BadGrammarException: `column level_prerequisites.chapter_id
       does not exist` from ChapterPrerequisiteRepository when
       /api/games/available/{characterId} ran ProgressionService —
       the home page came back with zero games for the player. -->
  <changeSet id="028-9-rename-level-prerequisites-table" author="nin">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="level_prerequisites"/>
    </preConditions>
    <renameTable oldTableName="level_prerequisites" newTableName="chapter_prerequisites"/>
  </changeSet>

  <changeSet id="028-10-rename-level-id-on-chapter-prerequisites" author="nin">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="chapter_prerequisites" columnName="level_id"/>
    </preConditions>
    <renameColumn tableName="chapter_prerequisites"
                  oldColumnName="level_id" newColumnName="chapter_id"/>
  </changeSet>

  <changeSet id="028-11-rename-prerequisite-index" author="nin">
    <preConditions onFail="MARK_RAN" onFailMessage="legacy index already renamed">
      <indexExists indexName="ix_level_prerequisites_level"/>
    </preConditions>
    <sql>ALTER INDEX ix_level_prerequisites_level RENAME TO ix_chapter_prerequisites_chapter</sql>
  </changeSet>

  <!-- 028-12 catches `scene_elements.level_id`. Symptom: 500 from
       /api/chapters/{id}/scene with R2DBC BadGrammarException
       `column scene_elements.chapter_id does not exist`, which
       breaks the in-game scene prefetch (the wizard cave bundle's
       index.html fetches /api/levels/{id}/scene at boot — see the
       backwards-compat alias on ChapterController). -->
  <changeSet id="028-12-rename-level-id-on-scene-elements" author="nin">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="scene_elements" columnName="level_id"/>
    </preConditions>
    <renameColumn tableName="scene_elements"
                  oldColumnName="level_id" newColumnName="chapter_id"/>
  </changeSet>

  <!-- 028-13 catches `quests.level_id` — the QuestRepository can hit
       the same column-not-found symptom on /api/quests/character/{id}
       once a player accrues quests. Found via:
         SELECT table_name, column_name FROM information_schema.columns
         WHERE column_name LIKE '%level%';
       which also returned routines.* (system catalog, ignored) and
       player_characters.level (XP level, intentionally preserved). -->
  <changeSet id="028-13-rename-level-id-on-quests" author="nin">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="quests" columnName="level_id"/>
    </preConditions>
    <renameColumn tableName="quests"
                  oldColumnName="level_id" newColumnName="chapter_id"/>
  </changeSet>

</databaseChangeLog>
