    <!--
      Optional override for the login role enrolled as a member of the
      least-privilege register.sql role (migration 054). Empty (default) enrols
      CURRENT_USER — the role Liquibase connects as, which is the BFF's R2DBC
      login role in every environment. Set -Dapp.register-sql.login-role=<role>
      only when Liquibase migrates as a privileged role distinct from the BFF
      login role.
    -->
    <property name="app.register-sql.login-role" value="" global="true"/>

