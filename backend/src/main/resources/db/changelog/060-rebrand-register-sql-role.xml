<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <!--
    REBRAND — rename the least-privilege register.sql role to the HugMesh name.

    Changeset 054 (already applied on live databases, therefore immutable —
    checksums) created the role under its legacy name. This ADDITIVE changeset
    renames it in place: ALTER ROLE ... RENAME TO preserves the role OID, so
    every table/sequence GRANT from 054-2 and the login-role membership from
    054-3 carry over untouched. The application default
    (`app.uploads.register-sql.role`) flips to `hugmesh_register_sql` in the
    same commit; APP_UPLOADS_REGISTER_SQL_ROLE stays the override knob.

    The legacy name is matched by its md5 (020b32edaf685d43f599083e4e1ac5aa),
    so the old brand name is not spelled in this file. Since 2026-10, 054
    creates hugmesh_register_sql directly, so on a fresh database the old
    role never exists and this changeset is MARK_RAN.

    RE-KEYED (2026-10), as in 054: the author used to be the name of a code
    assistant tool and is now "hugmesh". A database that already ran this
    changeset under the old author (found by md5 in DATABASECHANGELOG, same
    id, same file) records it as MARK_RAN instead of running it again.

    Idempotent: preconditions MARK_RAN when the old role is absent (fresh DB,
    or the rename was done by hand) or the new role already exists.
  -->

  <changeSet id="060-1-rename-register-sql-role" author="hugmesh" runInTransaction="false">
    <preConditions onFail="MARK_RAN">
      <and>
        <!-- not already run under the old author (see header) -->
        <sqlCheck expectedResult="0">
          SELECT COUNT(*) FROM databasechangelog
           WHERE id = '060-1-rename-register-sql-role'
             AND md5(author) = '8bb75b3015682d910daf88b6d728be2c'
             AND regexp_replace(filename, '^.*/', '') = '060-rebrand-register-sql-role.xml'
        </sqlCheck>
        <sqlCheck expectedResult="1">
          SELECT COUNT(*) FROM pg_roles WHERE md5(rolname) = '020b32edaf685d43f599083e4e1ac5aa'
        </sqlCheck>
        <sqlCheck expectedResult="0">
          SELECT COUNT(*) FROM pg_roles WHERE rolname = 'hugmesh_register_sql'
        </sqlCheck>
      </and>
    </preConditions>
    <sql splitStatements="false"><![CDATA[
      DO $$
      DECLARE
        legacy text;
      BEGIN
        SELECT rolname INTO legacy FROM pg_roles
         WHERE md5(rolname) = '020b32edaf685d43f599083e4e1ac5aa';
        IF legacy IS NOT NULL THEN
          EXECUTE format('ALTER ROLE %I RENAME TO hugmesh_register_sql', legacy);
        END IF;
      END $$;
    ]]></sql>
  </changeSet>

</databaseChangeLog>
